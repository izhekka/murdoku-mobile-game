# CocoaPods scaffolding, retained but inert (issue #52).
# Flutter drives iOS plugins through Swift Package Manager
# (FlutterGeneratedPluginSwiftPackage) now; this Podfile keeps the committed
# CocoaPods fallback alive without wiring any pods into the project:
# no `pod` declarations, and `:integrate_targets => false` so `pod install`
# can never re-add `Pods_` integration to Runner.xcodeproj.
# To use CocoaPods again (e.g. a plugin without Package.swift support):
# restore the podhelper target boilerplate from commit 43ab35a (the Runner
# target that installs the Flutter + plugin pods), run
# `flutter config --disable-swift-package-manager`, then `flutter build ios`
# and commit the regenerated Podfile.lock.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

install! 'cocoapods', :integrate_targets => false
